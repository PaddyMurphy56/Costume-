{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaddyMurphy56/Costume-/schemas/brief.schema.json",
  "title": "Costume brief",
  "description": "The shopping brief every system reads its constraints from (config/brief.yaml).",
  "type": "object",
  "required": ["brief_version", "character", "use", "dates", "budget", "owned", "needed"],
  "properties": {
    "brief_version": {"type": "integer", "minimum": 1},
    "character": {"type": "string", "minLength": 1},
    "look": {"type": "string"},
    "use": {"type": "string"},
    "location": {
      "type": "object",
      "required": ["city", "state"],
      "properties": {
        "city": {"type": "string"},
        "state": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "area": {"type": "string"},
        "local_pickup": {"type": "boolean"},
        "pickup_radius_miles": {"type": "number", "minimum": 0}
      }
    },
    "dates": {
      "type": "object",
      "required": ["buy_by", "event"],
      "properties": {
        "created": {"type": "string", "format": "date"},
        "buy_by": {"type": "string", "format": "date"},
        "event": {"type": "string", "format": "date"}
      }
    },
    "budget": {
      "type": "object",
      "required": ["currency", "total_max", "includes_shipping", "includes_tax"],
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "total_max": {"type": "number", "exclusiveMinimum": 0},
        "includes_shipping": {"type": "boolean"},
        "includes_tax": {"type": "boolean"},
        "est_tax_rate": {"type": "number", "minimum": 0, "maximum": 0.2}
      }
    },
    "runs": {
      "type": "object",
      "required": ["planned"],
      "properties": {
        "planned": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "minItems": 2,
          "maxItems": 2
        },
        "learn_from": {"type": "array", "items": {"type": "string"}}
      }
    },
    "output": {
      "type": "object",
      "required": ["mode", "assemble_costume"],
      "properties": {
        "mode": {"enum": ["gallery"]},
        "assemble_costume": {"type": "boolean"},
        "budget_helper": {"type": "string"}
      }
    },
    "extras": {
      "type": "object",
      "required": ["want", "budget_rule"],
      "properties": {
        "want": {"type": "string"},
        "sources": {"type": "array", "items": {"type": "string"}},
        "budget_rule": {"type": "string"}
      }
    },
    "owned": {"type": "array", "items": {"type": "string"}},
    "needed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "must"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "must": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "prefer": {"type": "array", "items": {"type": "string"}},
          "avoid": {"type": "array", "items": {"type": "string"}},
          "size": {"type": "object"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
